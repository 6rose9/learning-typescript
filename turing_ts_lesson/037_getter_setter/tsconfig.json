{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    // "module": "nodenext",
    "module": "CommonJS",
    "target": "esnext",
    "types": ["node"],
    "strict": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
  }
}
